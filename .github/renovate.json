{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"packageRules": [
		{
			"groupName": "effect",
			"matchPackageNames": ["effect", "/^@effect\\//"]
		},
		{
			"groupName": "opentui",
			"matchPackageNames": ["/^@opentui\\//", "solid-js"]
		}
	]
}
