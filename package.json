{
	"name": "@faststats/cli",
	"version": "0.1.1",
	"module": "src/index.ts",
	"type": "module",
	"bin": {
		"faststats": "./bin/faststats.cjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/faststats-dev/CLI.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"bin/faststats.cjs",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "bun run build:all && bun run scripts/publish.ts",
		"build": "bun run scripts/build.ts",
		"build:all": "bun run scripts/build-all.ts",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"completions:fish": "./faststats --completions fish",
		"completions:zsh": "./faststats --completions zsh",
		"completions:bash": "./faststats --completions bash",
		"install:completions": "bun run scripts/install-completions.ts fish",
		"install:completions:zsh": "bun run scripts/install-completions.ts zsh",
		"install:completions:bash": "bun run scripts/install-completions.ts bash",
		"download-openapi": "curl -fsS -o openapi.json https://api.faststats.dev/openapi.json",
		"generate": "openapigen --spec openapi.json --format httpclient --name Api > src/api.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "^3.0.3",
		"@effect/openapi-generator": "4.0.1",
		"@effect/platform-bun": "4.0.1",
		"@effect/platform-node": "4.0.1",
		"@opentui/core": "0.5.14",
		"@opentui/core-darwin-arm64": "0.5.14",
		"@opentui/core-darwin-x64": "0.5.14",
		"@opentui/core-linux-arm64": "0.5.14",
		"@opentui/core-linux-x64": "0.5.14",
		"@opentui/core-win32-arm64": "0.5.14",
		"@opentui/core-win32-x64": "0.5.14",
		"@opentui/solid": "0.5.14",
		"@types/bun": "^1.4.2",
		"@types/geojson": "^7946.0.16",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"effect": "4.0.1",
		"knip": "^6.39.0",
		"pkg-pr-new": "^0.0.90",
		"solid-js": "1.9.15",
		"topojson-client": "^3.1.0",
		"typescript": "7.0.2",
		"world-atlas": "^2.0.2"
	},
	"peerDependencies": {
		"typescript": "^5 || ^6 || ^7"
	}
}
